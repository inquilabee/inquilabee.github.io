---
interface Cluster {
  id: string;
  emoji: string;
  title: string;
}

interface Props {
  clusters: Cluster[];
}

const { clusters } = Astro.props;
---

<header class="hero rise">
  <div class="container">
    <p class="prompt mono" aria-hidden="true">
      <span class="user">inquilabee</span><span class="at">@</span><span class="host">github</span><span class="path">:~$</span>
      ls ./projects --group-by domain<span class="cursor">▌</span>
    </p>

    <h1>Vishal Kumar Mishra</h1>

    <p class="tagline">
      I build <strong>frameworks</strong>, use <strong>Pandas</strong> most days at work,
      and prefer one good abstraction over five config files.
    </p>

    <p class="sub">
      Day job: data analysis and validation on messy exports. Side repos: quality gates,
      DataFrame contracts, Streamlit patterns, and automation that survives real browsers.
      If the same glue shows up twice, it probably belongs in a package.
    </p>

    <p class="sub">
      Earlier depth: <strong>climate modeling</strong> — building and validating models on
      <strong>ITR (Implied Temperature Rise)</strong> in a data-driven application.
      <strong>Quant research</strong> on <strong>CRE (Commercial Real Estate)</strong> and
      <strong>WCR (Wholesale Credit Risk)</strong>. <strong>Django</strong> web apps and APIs,
      <strong>Python reporting</strong> tools for auditing in banks, and
      <strong>browser automation</strong> for scraping.
    </p>

    <p class="sub">
      This is the curated index. Full history lives on
      <a href="https://github.com/inquilabee">github.com/inquilabee</a>.
    </p>

    <nav class="cluster-nav mono" aria-label="Project domains">
      {clusters.map((c) => (
        <a href={`#${c.id}`}>
          <span class="nav-emoji" aria-hidden="true">{c.emoji}</span>
          {c.title}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .hero {
    padding: 5rem 0 1rem;
    border-bottom: 1px solid var(--border);
    background: linear-gradient(180deg, transparent, rgba(30, 41, 59, 0.55));
  }

  .prompt {
    color: var(--text-dim);
    font-size: 0.85rem;
    margin-bottom: 1.75rem;
  }

  .prompt .user { color: var(--accent); }
  .prompt .at { color: var(--text-faint); }
  .prompt .host { color: var(--text); }
  .prompt .path { color: var(--text-faint); margin-right: 0.6em; }

  .cursor {
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 0.75rem;
  }

  .tagline {
    font-size: clamp(1.05rem, 2.5vw, 1.3rem);
    color: var(--text);
    max-width: 46ch;
  }

  .tagline strong {
    color: var(--accent);
    font-weight: 500;
  }

  .sub {
    color: var(--text-dim);
    font-size: 0.95rem;
    margin-top: 0.75rem;
    max-width: 58ch;
  }

  .sub strong {
    color: var(--text);
    font-weight: 500;
  }

  .cluster-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 2.25rem 0 2rem;
  }

  .cluster-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-size: 0.78rem;
    color: var(--text-dim);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
    background: var(--bg-raised);
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .cluster-nav a:hover {
    color: var(--accent);
    border-color: var(--accent);
    text-decoration: none;
  }

  .nav-emoji {
    font-size: 0.9em;
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor { animation: none; }
  }
</style>
